{
  "name": "repo",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": ["web", "web-e2e", "api", "@todo/model", "@todo/ui"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node tools/checks/run.mjs",
          "pnpm exec ls-lint",
          "vale docs .agents REVIEW.md AGENTS.md README.md",
          "actionlint"
        ],
        "parallel": false
      }
    }
  }
}
