{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string", "pattern": "\\S", "maxLength": 200 },
    "completed": { "type": "boolean" },
    "dueDate": { "type": "string", "format": "date" }
  },
  "required": ["id", "title", "completed"],
  "additionalProperties": false
}
