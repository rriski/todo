{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["@todo/model"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/api"],
      "options": { "command": "go build -o ../../dist/api .", "cwd": "apps/api" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "go test -count=1 ./...", "cwd": "apps/api" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "golangci-lint run", "cwd": "apps/api" }
    },
    "fuzz": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test -run='^$' -fuzz=FuzzDecodeTask -fuzztime=30s .",
        "cwd": "apps/api"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": { "command": "go run .", "cwd": "apps/api" }
    }
  }
}
